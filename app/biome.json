{
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 111
	},
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true
	},

	"lint": {
		"complexity": {
			"useArrowFunction": false
		}
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useButtonType": "off",
				"useKeyWithClickEvents": "off"
			},
			"nursery": {
				"noJsxLiterals": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noAsignInExpression": "off"
			},
			"correctness": {
				"useUniqueElementIds": "off"
			}
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
